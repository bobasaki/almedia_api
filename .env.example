# Almedia Agency Data API key. The full key is shown only once, at creation.
# Keep it secret — anyone with it can read your campaign data. Never commit the real .env.
ALMEDIA_API_KEY=chak_your_key_here

# Optional: override the API base URL (defaults to https://api.almedia.tools)
# ALMEDIA_BASE_URL=https://api.almedia.tools

# YouTube Data API v3 key for creator enrichment. Keep the real key only in
# .env or the process environment; never commit it.
YOUTUBE_API_KEY=

# OpenAI API key for the integrated AI analyst (Insights tab). Optional —
# without it channel enrichment uses deterministic metadata analysis and the
# dashboard chat shows setup instructions.
# Create a project-scoped key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: override the analyst model (defaults to gpt-5.6-sol).
# OPENAI_MODEL=gpt-5.6-sol

# Optional: use a separate model for creator enrichment.
# OPENAI_ENRICHMENT_MODEL=gpt-5.6-terra
