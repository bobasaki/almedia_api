{
  "name": "almedia-agency-data-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone client for the Almedia Agency Data API. Built to the scouting-platform integrations convention so it ports into backend/packages/integrations as-is.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json",
    "build": "tsc -p tsconfig.json && pnpm dashboard:build",
    "pull": "node --env-file-if-exists=.env --import tsx scripts/pull.ts",
    "enrich:channels": "node --env-file-if-exists=.env --import tsx scripts/enrich-channels.ts",
    "migrate:sheet": "node --import tsx scripts/migrate-sheet.ts",
    "bookings:seed": "node --import tsx scripts/seed-bookings.ts",
    "dashboard": "node --env-file-if-exists=.env --import tsx dashboard/server.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "dashboard:start": "node --env-file-if-exists=.env --import tsx dashboard/server.ts --production"
  },
  "dependencies": {
    "openai": "^6.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^3.0.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
